{
  "name": "better-doubao",
  "version": "2.2.2",
  "description": "Enhance Doubao with visual layout & theme studio, chat folders, text highlights, corpus board, LaTeX & PDF/MD/TXT export.",
  "license": "MIT",
  "author": "Better Doubao Team",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:chrome",
    "dev:chrome": "vite build --config chrome/vite.config.ts --watch",
    "dev:edge": "vite build --config edge/vite.config.ts --watch",
    "build": "npm run build:chrome && npm run build:edge && node tests/build-artifacts.mjs",
    "build:chrome": "vite build --config chrome/vite.config.ts",
    "build:edge": "vite build --config edge/vite.config.ts",
    "test": "node tests/review-regressions.mjs && node tests/unit.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.2.1",
    "@types/chrome": "^0.1.40",
    "@types/webextension-polyfill": "^0.12.5",
    "typescript": "^5.3.3",
    "vite": "^5.4.0"
  }
}
