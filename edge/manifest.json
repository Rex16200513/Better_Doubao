{
  "manifest_version": 3,
  "name": "Better Doubao",
  "description": "A powerful browser extension to enhance your Doubao chat experience.",
  "version": "1.0.1",
  "icons": {
    "16": "icons/icon16.png",
    "19": "icons/icon19.png",
    "38": "icons/icon38.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/pages/popup/index.html",
    "default_icon": {
      "19": "icons/icon19.png",
      "38": "icons/icon38.png"
    }
  },
  "options_ui": {
    "page": "src/pages/options/index.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.doubao.com/*",
    "https://doubao.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "src/pages/background/index.ts"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.doubao.com/*",
        "https://doubao.com/*"
      ],
      "js": ["src/pages/content/index.ts"],
      "css": ["src/assets/styles/content.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/assets/styles/content.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
